# Copy this file to `.env` (which is git-ignored) and fill in real values.
# These names are read by the Spring Boot backend (as environment variables)
# and by docker-compose.yml.

# MySQL
DB_USERNAME=root
DB_PASSWORD=change-me
# Optional: override the full JDBC URL (defaults to jdbc:mysql://localhost:3306/subsidy_db ...)
# DB_URL=jdbc:mysql://localhost:3306/subsidy_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# JWT signing key - REQUIRED, at least 32 characters. Generate one with:
#   openssl rand -hex 32
#   (PowerShell) -join ((48..57)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
